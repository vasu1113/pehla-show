# Set to openai for real script-specific reactions and critic notes. The fake
# backend is only for deterministic local development and uses placeholder copy.
LLM_BACKEND=fake
STORE_BACKEND=file
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend-only: never expose this in src/ or any VITE_ variable; RLS is off.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated frontend origins, for example https://your-site.netlify.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5177,http://127.0.0.1:5177
# Set to true only on serverless hosts such as Vercel.
SYNC_PIPELINE=false
# Set to /api on Vercel, whose Python function is routed under that prefix.
API_ROOT_PATH=
# OPENAI_API_KEY=sk-...  # lands at the testing phase
# OPENAI_MODEL_PARSER=
# OPENAI_MODEL_SCORER=
# OPENAI_MODEL_EXPERT=
# OPENAI_MODEL_SYNTH=
PATIENCE_SCALE=0.15
MIN_BEATS_BEFORE_WALKOUT=3
WALKOUT_THRESHOLD=4.5

# Version every analysis ingredient that affects a cached result.
PIPELINE_VERSION=1
PARSER_VERSION=1
SCORER_VERSION=persona-pass-v1
SIMULATION_VERSION=patience-v2
